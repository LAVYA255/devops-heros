# Copy to .env (which is gitignored) and fill in real values.
#   cp .env.example .env

# Database password for docker compose. Pick anything; it never leaves your machine.
POSTGRES_PASSWORD=change-me

# Monthly spending budget shown in the UI, in rupees.
MONTHLY_BUDGET=20000

# Shown in the UI footer and /health. CI sets this to the git commit SHA.
APP_VERSION=local
