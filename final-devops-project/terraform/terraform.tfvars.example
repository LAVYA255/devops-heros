# Copy to terraform.tfvars (which is git-ignored) and adjust.
aws_region  = "ap-south-1"
project     = "kharcha"
environment = "prod"

vpc_cidr           = "10.20.0.0/16"
az_count           = 2
single_nat_gateway = true

create_eks      = true
cluster_version = "1.34"

# To run kubectl from your laptop, open the API to YOUR address only:
#   curl -s https://checkip.amazonaws.com
# endpoint_public_access = true
# public_access_cidrs    = ["203.0.113.7/32"]

node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 4
